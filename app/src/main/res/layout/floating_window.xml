<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_pill"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <ImageButton
        android:id="@+id/btn_start_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_play_24"
        android:tint="#4CAF50"
        android:contentDescription="开始"
        android:background="@drawable/bg_icon_btn"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_stop_24"
        android:tint="#F44336"
        android:contentDescription="停止"
        android:background="@drawable/bg_icon_btn"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_log"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_log_24"
        android:tint="#90CAF9"
        android:contentDescription="日志"
        android:background="@drawable/bg_icon_btn"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_config_float"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_settings_24"
        android:tint="#CE93D8"
        android:contentDescription="配置"
        android:background="@drawable/bg_icon_btn"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_close_24"
        android:tint="#BDBDBD"
        android:contentDescription="退出"
        android:background="@drawable/bg_icon_btn" />

</LinearLayout>
